{
  "id": "ppt-ugubhela-simon-fastfix",
  "name": "Ugubhela Simon — IT Fast Bro",
  "short_name": "Simon",
  "description": "Guided fixes for PC, Wi-Fi and phone, a real device scan, PDF to text and tasks. Works offline. By PixelProTech Solutions.",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#050507",
  "theme_color": "#050507",
  "lang": "en-ZA",
  "dir": "ltr",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Fix a problem", "short_name": "Fix", "description": "Open the Fix lane", "url": "./index.html?go=fix", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Scan this device", "short_name": "Scan", "description": "Run Pocket Scan", "url": "./index.html?go=scan", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "New task", "short_name": "Task", "description": "Add a task", "url": "./index.html?go=task", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf"] }]
    }
  }
}
